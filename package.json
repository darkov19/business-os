{
  "name": "business-os",
  "version": "0.3.0",
  "description": "Business OS installer, docs, and workflow package",
  "homepage": "https://github.com/darkov19/business-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkov19/business-os.git"
  },
  "bugs": {
    "url": "https://github.com/darkov19/business-os/issues"
  },
  "keywords": [
    "business",
    "workflow",
    "ai",
    "codex",
    "claude-code",
    "bmad",
    "planning",
    "strategy"
  ],
  "type": "module",
  "bin": {
    "business-os": "bin/business-os.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "docs",
    ".agents/skills",
    ".claude/commands",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "install:local": "node ./bin/business-os.js install",
    "doctor": "node ./bin/business-os.js doctor",
    "update:local": "node ./bin/business-os.js update",
    "pack:check": "npm pack --dry-run",
    "publish:check": "npm publish --dry-run",
    "release:pack": "npm pack --json --pack-destination /tmp/business-os-pack",
    "release:publish:dry-run": "npm publish --dry-run"
  }
}
